{
  "name": "@jiahao6635/skill-center",
  "version": "1.0.0",
  "description": "CLI for the self-hosted Sigmob Skill Center",
  "keywords": [
    "skillhub",
    "ai",
    "coding-agent",
    "skills",
    "cli"
  ],
  "homepage": "https://github.com/jiahao6635/skill-center#readme",
  "bugs": {
    "url": "https://github.com/jiahao6635/skill-center/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiahao6635/skill-center.git",
    "directory": "cli"
  },
  "license": "UNLICENSED",
  "author": "jiahao6635",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "skill-center": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "scripts": {
    "prebuild": "bun run scripts/generate-pkg-info.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js",
    "pretest": "bun run scripts/generate-pkg-info.ts",
    "test": "bun test",
    "pretypecheck": "bun run scripts/generate-pkg-info.ts",
    "typecheck": "tsc --noEmit",
    "prelint": "bun run scripts/generate-pkg-info.ts",
    "lint": "eslint src test --ext .ts",
    "prepack": "bun run build",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "fflate": "^0.8.2",
    "prompts": "^2.4.2",
    "semver": "^7.6.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
